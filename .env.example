APP_NAME="Inventario Contable"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (archivo database/database.sqlite, no requiere Docker).
DB_CONNECTION=sqlite

# Para usar MySQL (docker compose up -d mysql), comentar la línea de arriba y descomentar estas:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=inventario_contable
# DB_USERNAME=inventario
# DB_PASSWORD=inventario

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FRONTEND_URL=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME="del Sistema"
ADMIN_EMAIL=admin@inventario.local
ADMIN_DOCUMENT_NUMBER=00000000
ADMIN_PASSWORD=ChangeMe123!

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Autenticación JWT ---
# Generar con: php artisan jwt:secret
JWT_SECRET=
# Access token corto (minutos). La sesión se mantiene con el refresh token propio (tabla user_sessions).
JWT_TTL=15
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

# --- Políticas de seguridad ---
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_REFRESH_TTL_WEB_DAYS=1
SECURITY_REFRESH_TTL_MOVIL_DAYS=30
