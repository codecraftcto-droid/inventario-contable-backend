# Variables para Dokploy (Environment del servicio backend). Reemplaza TODO lo marcado con <...>.
# No subas este archivo con valores reales.

APP_NAME="Inventario Contable"
APP_ENV=production
APP_DEBUG=false
# Genera con: php artisan key:generate --show
APP_KEY=<base64:...>
APP_TIMEZONE=America/Lima
APP_URL=https://inventariocontable-backend.codecraft.net.pe
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Dominio del frontend (CORS). Varios separados por coma.
FRONTEND_URL=https://inventariocontable.codecraft.net.pe

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL de Dokploy (usar el "Internal Host" del servicio de base de datos)
DB_CONNECTION=mysql
DB_HOST=<internal-host-de-la-base>
DB_PORT=3306
DB_DATABASE=inventario_contable
DB_USERNAME="<usuario>"
DB_PASSWORD="<contraseña>"

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
BROADCAST_CONNECTION=log

# Genera con: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
JWT_SECRET=<64-caracteres-aleatorios>
JWT_TTL=15
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_REFRESH_TTL_WEB_DAYS=1
SECURITY_REFRESH_TTL_MOVIL_DAYS=30

# Administrador inicial (solo se usa con RUN_SEEDERS=true)
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME="del Sistema"
ADMIN_EMAIL=<correo-del-administrador>
ADMIN_DOCUMENT_NUMBER=00000000
ADMIN_PASSWORD="<contraseña-inicial-segura>"

# Migraciones en cada despliegue (recomendado: true)
RUN_MIGRATIONS=true
# SOLO la primera vez (restablece la contraseña del admin y los permisos de los roles). Luego: false.
RUN_SEEDERS=false
